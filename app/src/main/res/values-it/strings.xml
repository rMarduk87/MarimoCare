    <string name="marimo_tip_title_5">💡 Consiglio Marimo: Spazio per muoversi</string>
    <string name="marimo_tip_title_6">💡 Consiglio Marimo: Fai attenzione alle bolle</string>
    <string name="marimo_tip_title_7">💡 Consiglio Marimo: Cambiamenti stagionali</string>
