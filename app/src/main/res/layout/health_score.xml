<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/graph_marimo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:strokeColor="#D8F5E0"
    app:strokeWidth="1dp"
    android:backgroundTint="#F7FFFB">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Titolo -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:src="@drawable/ic_hearth"
                    app:tint="#00A676"
                    android:contentDescription="@string/img"
                    android:layout_width="22dp"
                    android:layout_height="22dp"/>

                <TextView
                    android:layout_marginStart="8dp"
                    android:text="@string/individual_health_score"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Spazio -->
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"/>

            <!-- RecyclerView ITEM come nella foto -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/marimoRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>

    </ScrollView>

</com.google.android.material.card.MaterialCardView>
