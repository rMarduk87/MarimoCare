<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/marimo_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/include1"
                layout="@layout/header" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- INIZIO BLOCCO HEADER DASHBOARD (invariato) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_header_dashboard"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/img"
                        android:src="@drawable/ic_water_drop_green" />

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/marimo_care_dashboard"
                        android:textColor="@color/marimo_black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="@color/marimo_stroke_light" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/btnOpenFeedbackDashboard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="4dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_feedback"
                                app:tint="@color/marimo_item_green" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/feedback"
                                android:textColor="@color/marimo_item_green"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnOpenChatDashboard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="4dp">

                            <ImageView
                                android:id="@+id/chatIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_topic_feedback"
                                app:tint="@color/marimo_item_green" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/questions"
                                android:textColor="@color/marimo_item_green"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <!-- FINE BLOCCO HEADER DASHBOARD -->

                <LinearLayout
                    android:id="@+id/alertCounterLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <!-- Contenuto rimosso per brevità, mantieni l'originale -->
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tipsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:elevation="2dp"
                    app:cardBackgroundColor="@color/marimo_background"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/marimo_item_edit_board"
                    app:strokeWidth="1dp">
                    <!-- Contenuto rimosso per brevità, mantieni l'originale -->
                </com.google.android.material.card.MaterialCardView>

                <!-- STRUTTURA AFFIANCATA (Layout Tablet/Desktop style) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- LATO SINISTRO: FILTRI E ORDINAMENTO -->
                    <LinearLayout
                        android:layout_width="280dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="20dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@android:color/white"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp"
                            app:strokeColor="@color/marimo_item_edit_board"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <!-- Toggles: Filters / Sorting -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:layout_marginBottom="16dp">

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnTabFilters"
                                        android:layout_width="0dp"
                                        android:layout_height="48dp"
                                        android:layout_weight="1"
                                        android:layout_marginEnd="4dp"
                                        android:background="@drawable/bg_btn_filled_green"
                                        android:text="@string/filters"
                                        android:textAllCaps="false"
                                        android:textColor="@android:color/white"
                                        app:backgroundTint="@null"
                                        app:icon="@drawable/ic_filter"
                                        app:iconTint="@android:color/white" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnTabSorting"
                                        android:layout_width="0dp"
                                        android:layout_height="48dp"
                                        android:layout_weight="1"
                                        android:layout_marginStart="4dp"
                                        android:background="@drawable/bg_btn_white"
                                        android:text="@string/sort"
                                        android:textAllCaps="false"
                                        android:textColor="@color/marimo_black"
                                        app:backgroundTint="@null"
                                        app:icon="@drawable/ic_sort"
                                        app:iconTint="@color/marimo_black" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/filterTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:visibility="gone">
                                </LinearLayout>

                                <!-- Ristrutturazione di buttonFilter in verticale -->
                                <LinearLayout
                                    android:id="@+id/buttonFilter"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:clipChildren="false"
                                    android:clipToPadding="false"
                                    android:layout_marginBottom="8dp">

                                    <FrameLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="8dp">

                                        <com.google.android.material.button.MaterialButton
                                            android:id="@+id/btnAllFilter"
                                            android:layout_width="match_parent"
                                            android:layout_height="48dp"
                                            android:background="@drawable/bg_btn_primary"
                                            android:paddingStart="16dp"
                                            android:text="@string/all"
                                            android:textAlignment="viewStart"
                                            android:textAllCaps="false"
                                            android:textColor="@android:color/white"
                                            app:backgroundTint="@null" />

                                        <TextView
                                            android:id="@+id/badgeAll"
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center_vertical|end"
                                            android:layout_marginEnd="12dp"
                                            android:background="@drawable/bg_badge_all"
                                            android:gravity="center"
                                            android:text="@string/_1"
                                            android:textColor="@color/marimo_dark"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />
                                    </FrameLayout>

                                    <FrameLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">

                                        <com.google.android.material.button.MaterialButton
                                            android:id="@+id/btnOverdueFilter"
                                            android:layout_width="match_parent"
                                            android:layout_height="48dp"
                                            android:background="@drawable/bg_btn_white"
                                            android:drawableEnd="@drawable/ic_warning_triangle_red"
                                            android:paddingStart="16dp"
                                            android:text="@string/overdue"
                                            android:textAlignment="viewStart"
                                            android:textAllCaps="false"
                                            android:textColor="@color/marimo_dark"
                                            app:backgroundTint="@null" />

                                        <TextView
                                            android:id="@+id/badgeOverdue"
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center_vertical|end"
                                            android:layout_marginEnd="12dp"
                                            android:background="@drawable/bg_badge_red"
                                            android:gravity="center"
                                            android:text="@string/_6"
                                            android:textColor="@color/marimo_red"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />
                                    </FrameLayout>
                                </LinearLayout>

                                <!-- Ristrutturazione di buttonFilter2 in verticale -->
                                <LinearLayout
                                    android:id="@+id/buttonFilter2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:clipChildren="false"
                                    android:clipToPadding="false">

                                    <FrameLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="8dp">

                                        <com.google.android.material.button.MaterialButton
                                            android:id="@+id/btnDueSoonFilter"
                                            android:layout_width="match_parent"
                                            android:layout_height="48dp"
                                            android:background="@drawable/bg_btn_white"
                                            android:drawableEnd="@drawable/ic_calendar_due_soon"
                                            android:paddingStart="16dp"
                                            android:text="@string/soon_f"
                                            android:textAlignment="viewStart"
                                            android:textAllCaps="false"
                                            android:textColor="@color/marimo_dark"
                                            app:backgroundTint="@null" />

                                        <TextView
                                            android:id="@+id/badgeDueSoon"
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center_vertical|end"
                                            android:layout_marginEnd="12dp"
                                            android:background="@drawable/bg_badge_orange"
                                            android:gravity="center"
                                            android:text="@string/_3"
                                            android:textColor="@color/marimo_orange"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />
                                    </FrameLayout>

                                    <FrameLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">

                                        <com.google.android.material.button.MaterialButton
                                            android:id="@+id/btnUpToDateFilter"
                                            android:layout_width="match_parent"
                                            android:layout_height="48dp"
                                            android:background="@drawable/bg_btn_white"
                                            android:drawableEnd="@drawable/ic_clock"
                                            android:paddingStart="16dp"
                                            android:text="@string/upToDate"
                                            android:textAlignment="viewStart"
                                            android:textAllCaps="false"
                                            android:textColor="@color/marimo_dark"
                                            app:backgroundTint="@null" />

                                        <TextView
                                            android:id="@+id/badgeUpToDate"
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center_vertical|end"
                                            android:layout_marginEnd="12dp"
                                            android:background="@drawable/bg_badge_green"
                                            android:gravity="center"
                                            android:text="@string/_4"
                                            android:textColor="@color/marimo_item_green"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />
                                    </FrameLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/sorts"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:visibility="gone">
                                    <include layout="@layout/spinner_sorting_with_arrow" android:id="@+id/marimoSpinnerLayout" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- LATO DESTRO: GRIGLIE E RECYCLER VIEW -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingBottom="16dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/your_marimos"
                                android:textColor="@color/marimo_black"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSelect"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_btn_outline_green"
                                android:text="@string/select"
                                android:textAllCaps="false"
                                android:textColor="@color/marimo_item_green"
                                app:backgroundTint="@null"
                                app:icon="@drawable/ic_check_box_outline"
                                app:iconTint="@color/marimo_item_green" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSelectAll"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginEnd="8dp"
                                android:visibility="gone" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDone"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginEnd="8dp"
                                android:visibility="gone" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddMarimo"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_btn_filled_green"
                                android:text="@string/add_marimo"
                                android:textAllCaps="false"
                                android:textColor="@android:color/white"
                                app:backgroundTint="@null"
                                app:icon="@drawable/ic_add"
                                app:iconTint="@android:color/white" />
                        </LinearLayout>

                        <!-- Griglie Statistiche e Liste invariate, usa quelle del file originale -->
                        <GridLayout
                            android:id="@+id/grid_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:alignmentMode="alignMargins"
                            android:columnCount="3"
                            android:rowCount="1"
                            android:useDefaultMargins="true">
                            <!-- Mantieni i MaterialCardView originali qui -->
                        </GridLayout>

                        <GridLayout
                            android:id="@+id/grid_status_alternative"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">
                        </GridLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerMarimos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/emptyListLabel"
                            style="@style/NoDataTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no_data"
                            android:visibility="gone" />

                        <include
                            android:id="@+id/include2"
                            layout="@layout/footer" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>