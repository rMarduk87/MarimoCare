<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/marimo_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/include1"
            layout="@layout/header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:paddingBottom="8dp"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_trending_up"
                    android:contentDescription="@string/img"
                    app:tint="@color/marimo_text_primary" />

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/marimo_care_stats"
                    android:layout_gravity="center"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/marimo_text_primary"
                    android:paddingBottom="4dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="16dp"
                android:text="@string/stats_sub_title"
                android:textColor="@color/marimo_text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/noLabelContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/no_stats"
                    android:text="@string/there_are_no_statistics_yet"
                    android:textColor="@color/marimo_dark"
                    android:textStyle="bold"
                    android:textSize="17sp">
                </TextView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <include
                    android:id="@+id/includeAF"
                    layout="@layout/stats_marimo" />

                <include
                    android:id="@+id/includeTWC"
                    layout="@layout/stats_marimo" />

                <include
                    android:id="@+id/includeAHS"
                    layout="@layout/stats_marimo" />

                <include
                    android:id="@+id/includeMF"
                    layout="@layout/stats_marimo" />

                <include
                    android:id="@+id/includeLF"
                    layout="@layout/stats_marimo" />

            </LinearLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@android:color/transparent"
                app:tabIndicatorColor="@color/marimo_text_primary"
                app:tabSelectedTextColor="@color/marimo_text_primary"
                app:tabTextColor="@color/marimo_text_secondary"
                app:tabIconTint="@color/marimo_text_primary"
                app:tabMode="fixed"
                app:tabGravity="fill">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:icon="@drawable/ic_trending_up"/>
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:icon="@drawable/ic_hearth"/>

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:icon="@android:drawable/ic_menu_sort_by_size"/>
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:icon="@drawable/ic_decorations"/>
            </com.google.android.material.tabs.TabLayout>

            <FrameLayout
                android:id="@+id/tabContentFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/tabContentTrends"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <include
                        android:id="@+id/includeDI"
                        layout="@layout/graph_marimo" />

                    <include
                        android:id="@+id/includeDC"
                        layout="@layout/graph_change_marimo" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabContentHealth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include
                        android:id="@+id/includeHS"
                        layout="@layout/health_score" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabContentCompare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include
                        android:id="@+id/includeMC"
                        layout="@layout/marimo_compare" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabContentDecorations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include
                        android:id="@+id/includePD"
                        layout="@layout/pot_decoration" />

                </LinearLayout>

            </FrameLayout>

            <include
                android:id="@+id/include2"
                layout="@layout/footer" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>