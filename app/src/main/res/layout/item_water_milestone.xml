<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="16dp">

    <View
        android:id="@+id/timelineLine"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/marimo_milestone_bg"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <FrameLayout
        android:id="@+id/timelineIconContainer"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_badge_orange"
        android:backgroundTint="@color/marimo_bg_warning"
        app:layout_constraintStart_toStartOf="@id/timelineLine"
        app:layout_constraintEnd_toEndOf="@id/timelineLine"
        app:layout_constraintTop_toTopOf="@id/marimoCard">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_star_outline"
            android:contentDescription="@string/img"
            app:tint="@color/marimo_tint_warning"/>
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/marimoCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/marimo_milestone_bg"
        android:backgroundTint="@color/white"
        app:layout_constraintStart_toEndOf="@id/timelineIconContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp">

            <TextView
                android:id="@+id/cardIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/star"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/cardTitle"/>

            <TextView
                android:id="@+id/cardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/milestone"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@id/cardIcon"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/cardDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/february_13_2026"
                android:textColor="@color/marimo_text_light_gray"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                app:layout_constraintStart_toStartOf="@id/cardTitle"
                app:layout_constraintTop_toBottomOf="@id/cardTitle"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/waterOrMilestoneImage"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_mountain"
                app:shapeAppearanceOverlay="@style/RoundedImageStyle"
                app:layout_constraintTop_toBottomOf="@id/cardDate"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/light_gray"
                android:padding="12dp"
                android:text="@string/damn_i_change_it"
                android:textColor="@color/marimo_text_sub_body"
                app:layout_constraintTop_toBottomOf="@id/waterOrMilestoneImage"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>