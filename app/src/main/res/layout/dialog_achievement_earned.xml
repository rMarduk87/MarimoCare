<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/txtAchievementIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/star"
        android:textSize="40sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/txtAchievementTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/achievement_earned"
        android:textColor="@color/green"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <TextView
        android:id="@+id/txtAchievementDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/marimo_text_dim"
        android:textSize="16sp"
        android:gravity="center"/>

    <Button
        android:id="@+id/btnOk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/great"
        android:backgroundTint="@color/green"
        android:textColor="@color/marimo_white" />

</LinearLayout>