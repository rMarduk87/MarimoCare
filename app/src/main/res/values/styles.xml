<?xml version="1.0" encoding="utf-8"?>
<resources>
    !-- Stile con angoli morbidi e consistenti -->
    <style name="Shape.Marimo.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Shape.Marimo.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Shape.Marimo.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Bottoni -->
    <style name="Widget.Marimo.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Card -->
    <style name="Widget.Marimo.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">6dp</item>
        <item name="android:background">@color/marimo_surface</item>
    </style>

    <!-- TextField -->
    <style name="Widget.Marimo.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/marimo_primary</item>
        <item name="hintTextColor">@color/marimo_text_hint</item>
        <item name="android:textColor">@color/marimo_text_primary</item>
    </style>

    <!-- Titoli -->
    <style name="Text.Marimo.Title" parent="@style/TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/marimo_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Testo corpo -->
    <style name="Text.Marimo.Body" parent="@style/TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/marimo_text_secondary</item>
    </style>

    <style name="NoDataTextView" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">24sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <!--Card View Contatore -->
    <style name="CardCounterStyle">
        <item name="cardBackgroundColor">@android:color/white</item>
    </style>

    <style name="RoundedImageStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="TopicButtonStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_button_outlined</item>
        <item name="android:padding">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TopicIconStyle">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
    </style>

    <style name="TopicTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">#111827</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

</resources>