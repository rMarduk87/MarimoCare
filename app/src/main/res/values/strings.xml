    <string name="marimo_tip_title_1">💡 Marimo Tip: Perfect Temperature</string>
    <string name="marimo_tip_title_2">💡 Marimo Tip: Gentle Rolling</string>
    <string name="marimo_tip_title_3">💡 Marimo Tip: Clean Water is Key</string>
