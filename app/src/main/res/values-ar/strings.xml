    <string name="marimo_tip_title_4">💡 نصيحة ماريمو: العيش في إضاءة منخفضة</string>
    <string name="marimo_tip_title_5">💡 نصيحة ماريمو: مساحة للتحرك</string>
    <string name="marimo_tip_title_6">💡 نصيحة ماريمو: راقب الفقاعات</string>
    <string name="marimo_tip_title_7">💡 نصيحة ماريمو: التغيرات الموسمية</string>
    <string name="marimo_tip_title_8">💡 نصيحة ماريمو: نمو بطيء</string>
