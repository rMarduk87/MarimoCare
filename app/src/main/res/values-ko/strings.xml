    <string name="marimo_tip_title_2">💡 팁: 부드럽게 굴리기</string>
    <string name="marimo_tip_title_3">💡 팁: 깨끗한 물이 필수입니다</string>
    <string name="marimo_tip_title_4">💡 팁: 적은 빛으로 생활하기</string>
